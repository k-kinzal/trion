unsat
(
(assume a0 (! (= x y) :named @p_1))
(assume a1 (! (not (! (= (bvadd x #b0001) (! (bvadd y #b0001) :named @p_2)) :named @p_3)) :named @p_4))
(step t0 (cl (not (! (= @p_4 false) :named @p_5)) (not @p_4) false) :rule equiv_pos2)
(step t1 (cl (= #b0001 #b0001)) :rule refl)
(step t2 (cl @p_3) :rule cong :premises (a0 t1))
(step t3 (cl (! (= @p_2 @p_2) :named @p_6)) :rule refl)
(step t4 (cl (= @p_3 @p_6)) :rule cong :premises (t2 t3))
(step t5 (cl (= @p_4 (! (not @p_6) :named @p_7))) :rule cong :premises (t4))
(step t6 (cl (= @p_6 true)) :rule hole :args ("untranslated rewrite"))
(step t7 (cl (= @p_7 (! (not true) :named @p_8))) :rule cong :premises (t6))
(step t8 (cl (= @p_8 false)) :rule hole :args ("untranslated rewrite"))
(step t9 (cl (= @p_7 false)) :rule trans :premises (t7 t8))
(step t10 (cl @p_5) :rule trans :premises (t5 t9))
(step t11 (cl false) :rule resolution :premises (t0 t10 a1))
(step t12 (cl (not false)) :rule false)
(step t13 (cl) :rule resolution :premises (t11 t12))
)

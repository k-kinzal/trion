unsat
(
(assume a0 p)
(assume a1 (! (not p) :named @p_1))
(step t0 (cl) :rule resolution :premises (a0 a1))
)
(
(assume a0 p)
(assume a1 (! (not p) :named @p_1))
(step t0 (cl) :rule resolution :premises (a0 a1))

unsat
(
(assume a0 (forall ((x U)) (P x)))
(assume a1 (exists ((y U)) (not (P y))))
(step t0 (cl (not (! (= (exists ((y U)) (not (P y))) (! (not (forall ((y U)) (P y))) :named @p_3)) :named @p_4)) (not (exists ((y U)) (not (P y)))) @p_3) :rule equiv_pos2)
(step t1 (cl (= (exists ((y U)) (not (P y))) (! (not (forall ((y U)) (not (not (P y))))) :named @p_5))) :rule hole :args ("untranslated rewrite"))
(anchor :step t2 :args ((y U) (:= (y U) y)))
(step t2.t0 (cl (= (not (not (! (P y) :named @p_2))) @p_2)) :rule hole :args ("untranslated rewrite"))
(step t2 (cl (= (forall ((y U)) (not (not (P y)))) (forall ((y U)) (P y)))) :rule bind)
(step t3 (cl (= @p_5 @p_3)) :rule cong :premises (t2))

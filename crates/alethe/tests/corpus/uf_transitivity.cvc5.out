(assume a3 (! (not (! (P (! (f c a) :named @p_5)) :named @p_6)) :named @p_7))
(step t0 (cl (not (! (= @p_7 (! (not (! (P (! (f c c) :named @p_8)) :named @p_9)) :named @p_12)) :named @p_13)) (not @p_7) @p_12) :rule equiv_pos2)
(step t1 (cl (! (= a c) :named @p_11)) :rule trans :premises (a0 a1))
(step t2 (cl (= @p_5 @p_8)) :rule cong :premises (t1))

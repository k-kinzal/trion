unsat
(
(declare-const p Bool)
(declare-const q Bool)
(define @t1 () (not p))
(assume @p1 (and p q))
(assume @p2 @t1)
(step @p3 :rule evaluate :args ((not true)))
(step @p4 :rule bool-eq-true :args (p))
(step @p5 :rule symm :premises (@p4))
(step @p6 :rule and_elim :premises (@p1) :args (0))
(step @p7 :rule eq_resolve :premises (@p6 @p5))
(step @p8 :rule cong :premises (@p7) :args (@t1))
(step @p9 :rule trans :premises (@p8 @p3))
(step @p10 false :rule eq_resolve :premises (@p2 @p9))
)
unsat
(
(declare-const p Bool)
(declare-const q Bool)
(define @t1 () (not q))
(assume @p1 (and p q))
(assume @p2 @t1)
(step @p3 :rule evaluate :args ((not true)))
(step @p4 :rule bool-eq-true :args (q))
(step @p5 :rule symm :premises (@p4))
(step @p6 :rule and_elim :premises (@p1) :args (1))
(step @p7 :rule eq_resolve :premises (@p6 @p5))
(step @p8 :rule cong :premises (@p7) :args (@t1))
(step @p9 :rule trans :premises (@p8 @p3))
(step @p10 false :rule eq_resolve :premises (@p2 @p9))
)

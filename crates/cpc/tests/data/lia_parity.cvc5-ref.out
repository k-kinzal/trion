unsat
(
(define @t1 () (* 2 y))
(define @t2 () (+ @t1 1))
(define @t3 () (* 2 x))
(define @t4 () (= @t3 @t2))
(define @t5 () (+ x (* -1 y)))
(define @t6 () (to_real @t5))
(define @t7 () (+ 1 @t1))
(define @t8 () (to_real @t7))
(define @t9 () (to_real @t3))
(define @t10 () (- @t9 @t8))
(define @t11 () (= @t9 @t8))
(assume @p1 @t4)
(step @p2 :rule evaluate :args ((= (to_real (to_int 1/2)) 1/2)))
(step @p3 :rule arith-int-eq-conflict :premises (@p2) :args (@t5 1/2))
(step @p4 :rule arith_poly_norm :args ((= (* -1/2 @t10) (* -1/1 (- @t6 1/2)))))
(step @p5 :rule arith_poly_norm_rel :premises (@p4) :args ((= @t11 (= @t6 1/2))))
(step @p6 :rule arith_poly_norm :args ((= (* -1/1 (to_real (- @t3 @t7))) (* -1/1 @t10))))
(step @p7 :rule arith_poly_norm_rel :premises (@p6) :args ((= (= @t3 @t7) @t11)))
(step @p8 :rule trans :premises (@p7 @p5 @p3))
(step @p9 :rule arith_poly_norm :args ((= @t2 @t7)))
(step @p10 :rule cong :premises (@p9) :args (@t4))
(step @p11 :rule trans :premises (@p10 @p8))
(step @p12 false :rule eq_resolve :premises (@p1 @p11))
)

unsat
(
(declare-const p31 Bool)
(declare-const p21 Bool)
(declare-const p22 Bool)
(declare-const p32 Bool)
(declare-const p11 Bool)
(declare-const p12 Bool)
(define @t1 () (@list true))
(define @t2 () (@list false))
(define @t3 () (@list p31))
(assume @p1 (or p11 p12))
(assume @p2 (or p21 p22))
(assume @p3 (or p31 p32))
(assume @p4 (not (and p11 p21)))
(assume @p5 (not (and p11 p31)))
(assume @p6 (not (and p21 p31)))
(assume @p7 (not (and p12 p22)))
(assume @p8 (not (and p12 p32)))
(assume @p9 (not (and p22 p32)))
(step @p10 :rule not_and :premises (@p8))
(step @p11 :rule not_and :premises (@p9))
(step @p12 :rule not_and :premises (@p4))
(step @p13 :rule chain_m_resolution :premises (@p12 @p2 @p1 @p11 @p10) :args ((not p32) (@list false false true true) (@list p21 p11 p22 p12)))
(step @p14 :rule chain_m_resolution :premises (@p3 @p13) :args (p31 @t1 (@list p32)))
(step @p15 :rule not_and :premises (@p5))
(step @p16 :rule chain_m_resolution :premises (@p15 @p14) :args ((not p11) @t2 @t3))
(step @p17 :rule chain_m_resolution :premises (@p1 @p16) :args (p12 @t1 (@list p11)))
(step @p18 :rule not_and :premises (@p6))
(step @p19 :rule chain_m_resolution :premises (@p18 @p14) :args ((not p21) @t2 @t3))
(step @p20 :rule chain_m_resolution :premises (@p2 @p19) :args (p22 @t1 (@list p21)))
(step @p21 :rule not_and :premises (@p7))
(step @p22 false :rule chain_m_resolution :premises (@p21 @p20 @p17) :args (false (@list false false) (@list p22 p12)))
)

unsat
(
(declare-sort U 0)
(declare-const P (-> U Bool))
(declare-const g (-> U U U))
(declare-const c U)
(declare-const a U)
(declare-const b U)
(define @t1 () (P c))
(define @t2 () (not @t1))
(define @t3 () (P a))
(define @t4 () (and @t3 @t2))
(define @t5 () (g c a))
(define @t6 () (g a c))
(define @t7 () (= @t6 @t5))
(define @t8 () (not @t7))
(define @t9 () (or @t8 @t4))
(define @t10 () (and @t1 @t2))
(define @t11 () (g c c))
(define @t12 () (not (= @t11 @t11)))
(assume @p1 (= a b))
(assume @p2 (= b c))
(assume @p3 @t9)
(step @p4 :rule aci_norm :args ((= (or false @t10) @t10)))
(step @p5 :rule refl :args (@t10))
(step @p6 :rule evaluate :args ((not true)))
(step @p7 :rule eq-refl :args (@t11))
(step @p8 :rule cong :premises (@p7) :args (@t12))
(step @p9 :rule trans :premises (@p8 @p6))
(step @p10 :rule nary_cong :premises (@p9 @p5) :args ((or @t12 @t10)))
(step @p11 :rule trans :premises (@p10 @p4))
(step @p12 :rule refl :args (@t2))
(step @p13 :rule trans :premises (@p1 @p2))
(step @p14 :rule cong :premises (@p13) :args (@t3))
(step @p15 :rule nary_cong :premises (@p14 @p12) :args (@t4))
(step @p16 :rule cong :premises (@p13) :args (@t5))
(step @p17 :rule refl :args (c))
(step @p18 :rule cong :premises (@p13 @p17) :args (@t6))
(step @p19 :rule cong :premises (@p18 @p16) :args (@t7))
(step @p20 :rule cong :premises (@p19) :args (@t8))
(step @p21 :rule nary_cong :premises (@p20 @p15) :args (@t9))
(step @p22 :rule trans :premises (@p21 @p11))
(step @p23 :rule eq_resolve :premises (@p3 @p22))
(step @p24 :rule and_elim :premises (@p23) :args (0))
(step @p25 :rule and_elim :premises (@p23) :args (1))
(step @p26 false :rule chain_m_resolution :premises (@p25 @p24) :args (false (@list false) (@list @t1)))
)

unsat
(
(declare-sort S 0)
(declare-const g (-> S Int))
(declare-const f (-> S Int S))
(declare-const a S)
(declare-const b S)
(define @t1 () (+ 1 2))
(define @t2 () (f b @t1))
(define @t3 () (g @t2))
(define @t4 () (f a 3))
(define @t5 () (g @t4))
(define @t6 () (= @t5 @t3))
(define @t7 () (not @t6))
(define @t8 () (g (f b 3)))
(define @t9 () (= @t5 @t8))
(assume @p1 (= a b))
(assume @p2 @t7)
(step @p3 :rule evaluate :args ((not true)))
(step @p4 :rule eq-refl :args (@t8))
(step @p5 :rule cong :premises (@p4) :args ((not (= @t8 @t8))))
(step @p6 :rule trans :premises (@p5 @p3))
(step @p7 :rule refl :args (@t8))
(step @p8 :rule refl :args (3))
(step @p9 :rule cong :premises (@p1 @p8) :args (@t4))
(step @p10 :rule cong :premises (@p9) :args (@t5))
(step @p11 :rule cong :premises (@p10 @p7) :args (@t9))
(step @p12 :rule cong :premises (@p11) :args ((not @t9)))
(step @p13 :rule trans :premises (@p12 @p6))
(step @p14 :rule evaluate :args (@t1))
(step @p15 :rule cong :premises (@p14) :args (@t2))
(step @p16 :rule cong :premises (@p15) :args (@t3))
(step @p17 :rule cong :premises (@p16) :args (@t6))
(step @p18 :rule cong :premises (@p17) :args (@t7))
(step @p19 :rule eq_resolve :premises (@p2 @p18))
(step @p20 false :rule eq_resolve :premises (@p19 @p13))
)

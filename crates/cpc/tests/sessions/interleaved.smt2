; Answers of several kinds around a proof: check-sat, get-value, get-model,
; get-info, echo, get-proof.
(set-option :produce-proofs true)
(set-option :produce-models true)
(set-logic QF_LIA)
(declare-fun x () Int)
(declare-fun y () Int)
(assert (> x 0))
(check-sat)
(get-value (x y))
(get-model)
(get-info :name)
(echo "between")
(push 1)
(assert (< x 0))
(check-sat)
(get-proof)
(pop 1)
(get-info :version)

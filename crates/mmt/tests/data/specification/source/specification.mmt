  contract35 : statement ❘ = stated "spec/sentences.trion:81" "spec/sentences.trion" 81 "The modal verb of a normative sentence is %22shall%22, %22must%22, %22should%22, or %22may%22." as_assumption vnil (timed (scons "activation: none; throughout the applicable system scope" (scons "state modal verb of normative sentence is shall or must or should or may: holds throughout the applicable system scope" snil))) in_document (contract (and (pcons (Dom "normative sentence modal verb" "shall") (pcons (Dom "normative sentence modal verb" "must") (pcons (Dom "normative sentence modal verb" "should") (pcons (Dom "normative sentence modal verb" "may") (pcons (or (pcons (Val "normative sentence modal verb" "shall") (pcons (Val "normative sentence modal verb" "must") (pcons (Val "normative sentence modal verb" "should") (pcons (Val "normative sentence modal verb" "may") pnil))))) pnil)))))) true)❙

  contract31 : statement ❘ = stated "spec/sentences.trion:52" "spec/sentences.trion" 52 "A specification is compatible exactly when at least one input satisfies the assumption of a contract of the specification." as_assumption vnil (timed (scons "activation: none; throughout the applicable system scope" (scons "state specification is compatible: holds throughout the applicable system scope" snil))) in_document (contract (and (pcons (implies (Event "input satisfy assumption of contract of specification") (Val "specification" "compatible")) (pcons (implies (Val "specification" "compatible") (Event "input satisfy assumption of contract of specification")) pnil))) true)❙
  contract32 : statement ❘ = stated "SENTENCE-INPUT-ENABLED" "spec/sentences.trion" 55 "The proof obligation of the consistency of each specification shall require a response to each input." as_guarantee vnil (timed (scons "activation: each invocation of require; operation require" (scons "action specification consistency proof obligation|require response to input: start(specification consistency proof obligation|require response to input) then complete(specification consistency proof obligation|require response to input); eventually complete(specification consistency proof obligation|require response to input)" snil))) unscoped (contract true (and (pcons (and (pcons (Act "specification consistency proof obligation|require response to input") (pcons (not (Forbid "specification consistency proof obligation|require response to input")) (pcons (not (Discouraged "specification consistency proof obligation|require response to input")) pnil)))) (pcons (Act "specification consistency proof obligation|require response") (pcons (not (Forbid "specification consistency proof obligation|require response")) pnil)))))❙

  contract437 : statement ❘ = stated "software::stdlib/software/trion.trion:9" "stdlib/software/trion.trion" 9 "A command means a program that a person runs by name." as_axiom vnil (timed snil) unscoped (contract true (and (pcons (implies (and (pcons (Dom "software::command" "program") (pcons (Dom "software::program" "author") pnil))) (Dom "software::command" "author")) (pcons (implies (and (pcons (Dom "software::command" "program") (pcons (Dom "software::program" "text") pnil))) (Dom "software::command" "text")) pnil))))❙

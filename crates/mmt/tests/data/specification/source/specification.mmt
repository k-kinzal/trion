  contract0 : statement ❘ = stated "spec/trion.trion:30" "spec/trion.trion" 30 "Each statement has exactly one formal meaning." as_assumption vnil (timed (scons "activation: none; throughout the applicable system scope" (scons "state each statement has exactly 1 formal meaning: holds throughout the applicable system scope" snil))) in_document (contract (implies (Event "exists statement") (and (pcons (Act "statement|has formal meaning") (pcons (Num "statement|has formal meaning count" "count" eq 1000) pnil)))) true)❙
  contract1 : statement ❘ = stated "spec/trion.trion:31/1" "spec/trion.trion" 31 "The trion language has a strict syntax." as_guarantee vnil (timed (scons "activation: none; throughout the applicable system scope" (scons "state trion language has strict syntax: holds throughout the applicable system scope" snil))) unscoped (contract true (Act "trion language|has strict syntax"))❙
  contract2 : statement ❘ = stated "spec/trion.trion:31/2" "spec/trion.trion" 31 "The trion language has a formal semantics." as_guarantee vnil (timed (scons "activation: none; throughout the applicable system scope" (scons "state trion language has formal semantic: holds throughout the applicable system scope" snil))) unscoped (contract true (Act "trion language|has formal semantic"))❙
  contract3 : statement ❘ = stated "spec/trion.trion:35/1" "spec/trion.trion" 35 "A specification has consistency." as_assumption vnil (timed (scons "activation: none; throughout the applicable system scope" (scons "state specification has consistency: holds throughout the applicable system scope" snil))) in_document (contract (implies (Event "exists specification") (Act "specification|has consistency")) true)❙
  contract4 : statement ❘ = stated "spec/trion.trion:35/2" "spec/trion.trion" 35 "A specification has compatibility." as_assumption vnil (timed (scons "activation: none; throughout the applicable system scope" (scons "state specification has compatibility: holds throughout the applicable system scope" snil))) in_document (contract (implies (Event "exists specification") (Act "specification|has compatibility")) true)❙
  contract5 : statement ❘ = stated "spec/trion.trion:35/3" "spec/trion.trion" 35 "A specification has correctness." as_assumption vnil (timed (scons "activation: none; throughout the applicable system scope" (scons "state specification has correctness: holds throughout the applicable system scope" snil))) in_document (contract (implies (Event "exists specification") (Act "specification|has correctness")) true)❙
  contract6 : statement ❘ = stated "spec/trion.trion:35/4" "spec/trion.trion" 35 "A specification has completeness." as_assumption vnil (timed (scons "activation: none; throughout the applicable system scope" (scons "state specification has completeness: holds throughout the applicable system scope" snil))) in_document (contract (implies (Event "exists specification") (Act "specification|has completeness")) true)❙
  contract7 : statement ❘ = stated "TRION-COMPILER/1" "spec/trion.trion" 38 "The trion processor shall convert each specification into the proof obligations of the consistency." as_guarantee vnil (timed (scons "activation: each invocation of convert; operation convert" (scons "action trion processor|convert specification into proof obligation of consistency: start(trion processor|convert specification into proof obligation of consistency) then complete(trion processor|convert specification into proof obligation of consistency); eventually complete(trion processor|convert specification into proof obligation of consistency)" snil))) unscoped (contract true (and (pcons (and (pcons (Act "trion processor|convert specification into proof obligation of consistency") (pcons (not (Forbid "trion processor|convert specification into proof obligation of consistency")) (pcons (not (Discouraged "trion processor|convert specification into proof obligation of consistency")) pnil)))) (pcons (Act "trion processor|convert specification") (pcons (not (Forbid "trion processor|convert specification")) pnil)))))❙
  contract8 : statement ❘ = stated "TRION-COMPILER/2" "spec/trion.trion" 38 "The trion processor shall convert each specification into the compatibility." as_guarantee vnil (timed (scons "activation: each invocation of convert; operation convert" (scons "action trion processor|convert specification into compatibility: start(trion processor|convert specification into compatibility) then complete(trion processor|convert specification into compatibility); eventually complete(trion processor|convert specification into compatibility)" snil))) unscoped (contract true (and (pcons (and (pcons (Act "trion processor|convert specification into compatibility") (pcons (not (Forbid "trion processor|convert specification into compatibility")) (pcons (not (Discouraged "trion processor|convert specification into compatibility")) pnil)))) (pcons (Act "trion processor|convert specification") (pcons (not (Forbid "trion processor|convert specification")) pnil)))))❙
  contract9 : statement ❘ = stated "TRION-COMPILER/3" "spec/trion.trion" 38 "The trion processor shall convert each specification into the correctness." as_guarantee vnil (timed (scons "activation: each invocation of convert; operation convert" (scons "action trion processor|convert specification into correctness: start(trion processor|convert specification into correctness) then complete(trion processor|convert specification into correctness); eventually complete(trion processor|convert specification into correctness)" snil))) unscoped (contract true (and (pcons (and (pcons (Act "trion processor|convert specification into correctness") (pcons (not (Forbid "trion processor|convert specification into correctness")) (pcons (not (Discouraged "trion processor|convert specification into correctness")) pnil)))) (pcons (Act "trion processor|convert specification") (pcons (not (Forbid "trion processor|convert specification")) pnil)))))❙
  contract10 : statement ❘ = stated "TRION-COMPILER/4" "spec/trion.trion" 38 "The trion processor shall convert each specification into the completeness of the specification." as_guarantee vnil (timed (scons "activation: each invocation of convert; operation convert" (scons "action trion processor|convert specification into completeness of specification: start(trion processor|convert specification into completeness of specification) then complete(trion processor|convert specification into completeness of specification); eventually complete(trion processor|convert specification into completeness of specification)" snil))) unscoped (contract true (and (pcons (and (pcons (Act "trion processor|convert specification into completeness of specification") (pcons (not (Forbid "trion processor|convert specification into completeness of specification")) (pcons (not (Discouraged "trion processor|convert specification into completeness of specification")) pnil)))) (pcons (Act "trion processor|convert specification") (pcons (not (Forbid "trion processor|convert specification")) pnil)))))❙
  contract11 : statement ❘ = stated "TRION-THEORY" "spec/trion.trion" 41 "The trion processor shall follow the theory of contracts." as_guarantee vnil (timed (scons "activation: each invocation of follow; operation follow" (scons "action trion processor|follow theory of contract: start(trion processor|follow theory of contract) then complete(trion processor|follow theory of contract); eventually complete(trion processor|follow theory of contract)" snil))) unscoped (contract true (and (pcons (Act "trion processor|follow theory of contract") (pcons (not (Forbid "trion processor|follow theory of contract")) (pcons (not (Discouraged "trion processor|follow theory of contract")) pnil)))))❙
  contract12 : statement ❘ = stated "spec/trion.trion:44" "spec/trion.trion" 44 "Each specification describes a system." as_assumption vnil (timed (scons "activation: none; throughout the applicable system scope" (scons "state each specification describe system: holds throughout the applicable system scope" snil))) in_document (contract (implies (Event "exists specification") (Act "specification|describe system")) true)❙
  contract13 : statement ❘ = stated "spec/trion.trion:45" "spec/trion.trion" 45 "Each specification is a document." as_assumption vnil (timed (scons "activation: none; throughout the applicable system scope" (scons "state each specification is document: holds throughout the applicable system scope" snil))) in_document (contract (Dom "specification" "document") true)❙
  contract14 : statement ❘ = stated "TRION-DOCUMENT" "spec/trion.trion" 49 "Each specification shall serve as the documentation of a system." as_assumption vnil (timed (scons "activation: each invocation of serve; operation serve" (scons "action specification|serve as documentation of system: start(specification|serve as documentation of system) then complete(specification|serve as documentation of system); eventually complete(specification|serve as documentation of system)" snil))) in_document (contract (and (pcons (and (pcons (Act "specification|serve as documentation of system") (pcons (not (Forbid "specification|serve as documentation of system")) (pcons (not (Discouraged "specification|serve as documentation of system")) pnil)))) (pcons (Act "specification|serve") (pcons (not (Forbid "specification|serve")) pnil)))) true)❙
  contract15 : statement ❘ = stated "TRION-RIGOR-FIRST" "spec/trion.trion" 52 "If readability conflicts with rigor, then the trion language shall prefer rigor." as_guarantee vnil (timed (scons "activation: each unwanted occurrence of Event(readability conflict with rigor)" (scons "obligation: open from the trigger occurrence until satisfaction; a later change of the gate does not close it" (scons "action trion language|prefer rigor: start(trion language|prefer rigor) then complete(trion language|prefer rigor); eventually complete(trion language|prefer rigor)" snil)))) unscoped (contract (Event "readability conflict with rigor") (and (pcons (Act "trion language|prefer rigor") (pcons (not (Forbid "trion language|prefer rigor")) (pcons (not (Discouraged "trion language|prefer rigor")) pnil)))))❙
  contract16 : statement ❘ = stated "TRION-EVIDENCE" "spec/trion.trion" 61 "Each statement shall have evidence." as_assumption vnil (timed (scons "activation: each invocation of have; operation have" (scons "action statement|have evidence: start(statement|have evidence) then complete(statement|have evidence); eventually complete(statement|have evidence)" snil))) in_document (contract (and (pcons (Act "statement|have evidence") (pcons (not (Forbid "statement|have evidence")) (pcons (not (Discouraged "statement|have evidence")) pnil)))) true)❙
  contract17 : statement ❘ = stated "TRION-EVIDENCE-AUDIT" "spec/trion.trion" 64 "The trion processor shall trace each statement to the evidence of the statement." as_guarantee vnil (timed (scons "activation: each invocation of trace; operation trace" (scons "action trion processor|trace statement to evidence of statement: start(trion processor|trace statement to evidence of statement) then complete(trion processor|trace statement to evidence of statement); eventually complete(trion processor|trace statement to evidence of statement)" snil))) unscoped (contract true (and (pcons (and (pcons (Act "trion processor|trace statement to evidence of statement") (pcons (not (Forbid "trion processor|trace statement to evidence of statement")) (pcons (not (Discouraged "trion processor|trace statement to evidence of statement")) pnil)))) (pcons (Act "trion processor|trace statement") (pcons (not (Forbid "trion processor|trace statement")) pnil)))))❙
  contract18 : statement ❘ = stated "spec/trion.trion:66" "spec/trion.trion" 66 "Verification guarantees the internal consistency of a specification." as_assumption vnil (timed (scons "activation: none; throughout the applicable system scope" (scons "state verification guarantee internal consistency of specification: holds throughout the applicable system scope" snil))) in_document (contract (implies (Event "exists verification") (Act "verification|guarantee internal consistency of specification")) true)❙
  contract19 : statement ❘ = stated "spec/trion.trion:67" "spec/trion.trion" 67 "Evidence guarantees no validity." as_assumption vnil (timed (scons "activation: none; throughout the applicable system scope" (scons "state evidence guarantee no validity: holds throughout the applicable system scope" snil))) in_document (contract (implies (Event "exists evidence") (not (Act "evidence|guarantee validity"))) true)❙
  contract20 : statement ❘ = stated "spec/trion.trion:68" "spec/trion.trion" 68 "A person audits the validity of a specification with the evidence of the specification." as_assumption vnil (timed (scons "activation: none; throughout the applicable system scope" (scons "state person audit validity of specification with evidence of specification: holds throughout the applicable system scope" snil))) in_document (contract (implies (Event "exists person") (Act "person|audit validity of specification")) true)❙
  contract21 : statement ❘ = stated "spec/sentences.trion:10" "spec/sentences.trion" 10 "The reading of a simple sentence is exactly one contract." as_assumption vnil (timed (scons "activation: none; throughout the applicable system scope" (scons "state reading of simple sentence is equal to one contract: holds throughout the applicable system scope" snil))) in_document (contract (Num "simple sentence reading" "contract" eq 1000) true)❙
  contract22 : statement ❘ = stated "spec/sentences.trion:11" "spec/sentences.trion" 11 "The formal meaning of a specification is the conjunction of the contracts of the statements of the specification." as_assumption vnil (timed (scons "activation: none; throughout the applicable system scope" (scons "state formal meaning of specification is conjunction of contract of statement of specification: holds throughout the applicable system scope" snil))) in_document (contract (Dom "specification formal meaning" "specification statement contract conjunction") true)❙
  contract23 : statement ❘ = stated "SENTENCE-ONE-CONTRACT" "spec/sentences.trion" 14 "The trion processor shall read each simple sentence as exactly one contract." as_guarantee vnil (timed (scons "activation: each invocation of read; operation read" (scons "action trion processor|read simple sentence as exactly 1 contract: start(trion processor|read simple sentence as exactly 1 contract) then complete(trion processor|read simple sentence as exactly 1 contract); eventually complete(trion processor|read simple sentence as exactly 1 contract)" snil))) unscoped (contract true (and (pcons (and (pcons (Act "trion processor|read simple sentence as exactly 1 contract") (pcons (not (Forbid "trion processor|read simple sentence as exactly 1 contract")) (pcons (not (Discouraged "trion processor|read simple sentence as exactly 1 contract")) pnil)))) (pcons (Act "trion processor|read simple sentence") (pcons (not (Forbid "trion processor|read simple sentence")) pnil)))))❙
  contract24 : statement ❘ = stated "SENTENCE-VERIFIABLE" "spec/sentences.trion" 17 "The trion processor shall transform each contract into formulas." as_guarantee vnil (timed (scons "activation: each invocation of transform; operation transform" (scons "action trion processor|transform contract into formula: start(trion processor|transform contract into formula) then complete(trion processor|transform contract into formula); eventually complete(trion processor|transform contract into formula)" snil))) unscoped (contract true (and (pcons (and (pcons (Act "trion processor|transform contract into formula") (pcons (not (Forbid "trion processor|transform contract into formula")) (pcons (not (Discouraged "trion processor|transform contract into formula")) pnil)))) (pcons (Act "trion processor|transform contract") (pcons (not (Forbid "trion processor|transform contract")) pnil)))))❙
  contract25 : statement ❘ = stated "SENTENCE-RESPONSIBILITY" "spec/sentences.trion" 34 "The trion processor shall read each phrase that constrains the environment of a specification as a part of an assumption." as_guarantee vnil (timed (scons "activation: each invocation of read; operation read" (scons "action trion processor|read phrase that constrain environment of specification as part of assumption: start(trion processor|read phrase that constrain environment of specification as part of assumption) then complete(trion processor|read phrase that constrain environment of specification as part of assumption); eventually complete(trion processor|read phrase that constrain environment of specification as part of assumption)" snil))) unscoped (contract true (and (pcons (Act "trion processor|read phrase that constrain environment of specification as part of assumption") (pcons (not (Forbid "trion processor|read phrase that constrain environment of specification as part of assumption")) (pcons (not (Discouraged "trion processor|read phrase that constrain environment of specification as part of assumption")) pnil)))))❙
  contract26 : statement ❘ = stated "SENTENCE-GUARANTEE" "spec/sentences.trion" 37 "The trion processor shall read each phrase that constrains the system of a specification as a part of a guarantee." as_guarantee vnil (timed (scons "activation: each invocation of read; operation read" (scons "action trion processor|read phrase that constrain system of specification as part of guarantee: start(trion processor|read phrase that constrain system of specification as part of guarantee) then complete(trion processor|read phrase that constrain system of specification as part of guarantee); eventually complete(trion processor|read phrase that constrain system of specification as part of guarantee)" snil))) unscoped (contract true (and (pcons (Act "trion processor|read phrase that constrain system of specification as part of guarantee") (pcons (not (Forbid "trion processor|read phrase that constrain system of specification as part of guarantee")) (pcons (not (Discouraged "trion processor|read phrase that constrain system of specification as part of guarantee")) pnil)))))❙
  contract27 : statement ❘ = stated "spec/sentences.trion:41" "spec/sentences.trion" 41 "A descriptive sentence follows the responsibility of a normative sentence." as_assumption vnil (timed (scons "activation: none; throughout the applicable system scope" (scons "state descriptive sentence follow responsibility of normative sentence: holds throughout the applicable system scope" snil))) in_document (contract (implies (Event "exists descriptive sentence") (Act "descriptive sentence|follow responsibility of normative sentence")) true)❙
  contract28 : statement ❘ = stated "spec/sentences.trion:44" "spec/sentences.trion" 44 "A behavior satisfies a contract exactly when the assumption of the contract does not hold in the behavior or the guarantee of the contract holds in the behavior." as_assumption vnil (timed (scons "activation: none; throughout the applicable system scope" (scons "state behavior satisfy contract: holds throughout the applicable system scope" snil))) in_document (contract (and (pcons (implies (or (pcons (not (Event "assumption of contract hold in behavior")) (pcons (Event "guarantee of contract hold in behavior") pnil))) (implies (Event "exists behavior") (Act "behavior|satisfy contract"))) (pcons (implies (implies (Event "exists behavior") (Act "behavior|satisfy contract")) (or (pcons (not (Event "assumption of contract hold in behavior")) (pcons (Event "guarantee of contract hold in behavior") pnil)))) pnil))) true)❙
  contract29 : statement ❘ = stated "spec/sentences.trion:45" "spec/sentences.trion" 45 "A specification is satisfiable exactly when at least one behavior satisfies each contract of the specification." as_assumption vnil (timed (scons "activation: none; throughout the applicable system scope" (scons "state specification is satisfiable: holds throughout the applicable system scope" snil))) in_document (contract (and (pcons (implies (Event "behavior satisfy contract of specification") (Val "specification" "satisfiable")) (pcons (implies (Val "specification" "satisfiable") (Event "behavior satisfy contract of specification")) pnil))) true)❙

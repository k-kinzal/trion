  contract442 : statement ❘ = stated "spec/sentences.trion:179" "spec/sentences.trion" 179 "A behavior satisfies each contract whose assumption does not hold in the behavior." as_axiom vnil (timed snil) unscoped (contract true (and (pcons (implies (Act "behavior|satisfy contract") (Act "behavior|satisfy contract whose assumption does not hold in behavior")) (pcons (implies (Forbid "behavior|satisfy contract") (Forbid "behavior|satisfy contract whose assumption does not hold in behavior")) (pcons (implies (Discouraged "behavior|satisfy contract") (Discouraged "behavior|satisfy contract whose assumption does not hold in behavior")) pnil)))))❙

  contract439 : statement ❘ = stated "software::stdlib/software/trion.trion:13" "stdlib/software/trion.trion" 13 "An editor means a program that shows a text to a person." as_axiom vnil (timed snil) unscoped (contract true (and (pcons (implies (and (pcons (Dom "software::editor" "program") (pcons (Dom "software::program" "author") pnil))) (Dom "software::editor" "author")) (pcons (implies (and (pcons (Dom "software::editor" "program") (pcons (Dom "software::program" "text") pnil))) (Dom "software::editor" "text")) pnil))))❙

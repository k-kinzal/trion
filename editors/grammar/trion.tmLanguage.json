{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Trion",
  "scopeName": "source.trion",
  "fileTypes": [
    "trion"
  ],
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#file-directive"
    },
    {
      "include": "#namespace-header"
    },
    {
      "include": "#section-header"
    },
    {
      "include": "#flow-block"
    },
    {
      "include": "#source-block"
    },
    {
      "include": "#check-block"
    },
    {
      "include": "#example-block"
    },
    {
      "include": "#trace-block"
    },
    {
      "include": "#role-block"
    },
    {
      "include": "#concept-block"
    },
    {
      "include": "#diagram-kind-block"
    },
    {
      "include": "#compatibility-block"
    },
    {
      "include": "#diagram-header"
    },
    {
      "include": "#directive"
    },
    {
      "include": "#annotation"
    },
    {
      "include": "#spec-id-declaration"
    },
    {
      "include": "#sentence"
    }
  ],
  "repository": {
    "comment": {
      "match": "(//).*$",
      "name": "comment.line.double-slash.trion",
      "captures": {
        "1": {
          "name": "punctuation.definition.comment.trion"
        }
      }
    },
    "strings": {
      "patterns": [
        {
          "include": "#raw-string"
        },
        {
          "include": "#string"
        }
      ]
    },
    "raw-string": {
      "begin": "\"\"\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.trion"
        }
      },
      "end": "\"\"\"",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.trion"
        }
      },
      "name": "string.quoted.triple.trion"
    },
    "string": {
      "begin": "\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.trion"
        }
      },
      "end": "(\")|$",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.string.end.trion"
        }
      },
      "name": "string.quoted.double.trion",
      "patterns": [
        {
          "include": "#escape"
        }
      ]
    },
    "escape": {
      "match": "\\\\.",
      "name": "constant.character.escape.trion"
    },
    "block-colon": {
      "match": ":(?=\\s*(?://.*)?$)",
      "name": "punctuation.section.block.begin.trion"
    },
    "file-directive": {
      "patterns": [
        {
          "begin": "^\\s*(refer|apply)\\s+(\\S+)",
          "beginCaptures": {
            "1": {
              "name": "keyword.other.directive.trion"
            },
            "2": {
              "name": "entity.name.namespace.package.trion"
            }
          },
          "end": "$",
          "patterns": [
            {
              "include": "#string"
            },
            {
              "include": "#comment"
            }
          ]
        },
        {
          "begin": "^\\s*(package)\\s+([a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)*)(?=\\s*(?://.*)?$)",
          "beginCaptures": {
            "1": {
              "name": "keyword.other.directive.package.trion"
            },
            "2": {
              "name": "entity.name.namespace.package.trion"
            }
          },
          "end": "$",
          "name": "meta.directive.package.trion",
          "patterns": [
            {
              "include": "#string"
            },
            {
              "include": "#comment"
            }
          ]
        },
        {
          "begin": "^\\s*(include)(?=\\s+\")",
          "beginCaptures": {
            "1": {
              "name": "keyword.other.directive.include.trion"
            }
          },
          "end": "$",
          "name": "meta.directive.include.trion",
          "patterns": [
            {
              "include": "#string"
            },
            {
              "include": "#comment"
            }
          ]
        }
      ]
    },
    "namespace-header": {
      "match": "^\\s*(namespace)\\s+([A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*)\\s*(:)?(?=\\s*(?://.*)?$)",
      "name": "meta.block.namespace.trion",
      "captures": {
        "1": {
          "name": "storage.type.namespace.trion"
        },
        "2": {
          "name": "entity.name.namespace.trion"
        },
        "3": {
          "name": "punctuation.section.block.begin.trion"
        }
      }
    },
    "section-header": {
      "begin": "^\\s*(section)(?=\\s+\")",
      "beginCaptures": {
        "1": {
          "name": "storage.type.section.trion"
        }
      },
      "end": "$",
      "name": "meta.block.section.trion",
      "patterns": [
        {
          "include": "#section-title"
        },
        {
          "include": "#block-colon"
        },
        {
          "include": "#comment"
        }
      ]
    },
    "section-title": {
      "begin": "\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.trion"
        }
      },
      "end": "(\")|$",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.string.end.trion"
        }
      },
      "name": "string.quoted.double.trion entity.name.section.trion",
      "patterns": [
        {
          "include": "#escape"
        }
      ]
    },
    "source-block": {
      "name": "meta.block.source.trion",
      "begin": "^([ \\t]*)(source)\\s+([A-Z][A-Z0-9-]*)\\s*(:)(?=\\s*(?://.*)?$)",
      "beginCaptures": {
        "2": {
          "name": "storage.type.source.trion"
        },
        "3": {
          "name": "entity.name.source.trion"
        },
        "4": {
          "name": "punctuation.section.block.begin.trion"
        }
      },
      "end": "(?!\\G)^(?!\\1[ \\t]+\\S|[ \\t]*$)",
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "begin": "^\\s*(quote)\\s+([A-Z][A-Z0-9-]*)(?=\\s)",
          "beginCaptures": {
            "1": {
              "name": "keyword.other.field.quote.trion"
            },
            "2": {
              "name": "entity.name.quote.trion"
            }
          },
          "end": "$",
          "name": "meta.field.quote.trion",
          "patterns": [
            {
              "include": "#strings"
            },
            {
              "include": "#comment"
            }
          ]
        },
        {
          "patterns": [
            {
              "begin": "^\\s*(title)(?=\\s)",
              "beginCaptures": {
                "1": {
                  "name": "keyword.other.field.title.trion"
                }
              },
              "end": "$",
              "name": "meta.field.title.trion",
              "patterns": [
                {
                  "include": "#strings"
                },
                {
                  "include": "#comment"
                }
              ]
            },
            {
              "begin": "^\\s*(locator)(?=\\s)",
              "beginCaptures": {
                "1": {
                  "name": "keyword.other.field.locator.trion"
                }
              },
              "end": "$",
              "name": "meta.field.locator.trion",
              "patterns": [
                {
                  "include": "#strings"
                },
                {
                  "include": "#comment"
                }
              ]
            },
            {
              "begin": "^\\s*(revision)(?=\\s)",
              "beginCaptures": {
                "1": {
                  "name": "keyword.other.field.revision.trion"
                }
              },
              "end": "$",
              "name": "meta.field.revision.trion",
              "patterns": [
                {
                  "include": "#strings"
                },
                {
                  "include": "#comment"
                }
              ]
            },
            {
              "begin": "^\\s*(select)(?=\\s)",
              "beginCaptures": {
                "1": {
                  "name": "keyword.other.field.select.trion"
                }
              },
              "end": "$",
              "name": "meta.field.select.trion",
              "patterns": [
                {
                  "include": "#strings"
                },
                {
                  "include": "#comment"
                }
              ]
            },
            {
              "begin": "^\\s*(path)(?=\\s)",
              "beginCaptures": {
                "1": {
                  "name": "keyword.other.field.path.trion"
                }
              },
              "end": "$",
              "name": "meta.field.path.trion",
              "patterns": [
                {
                  "include": "#strings"
                },
                {
                  "include": "#comment"
                }
              ]
            },
            {
              "begin": "^\\s*(sha256)(?=\\s)",
              "beginCaptures": {
                "1": {
                  "name": "keyword.other.field.sha256.trion"
                }
              },
              "end": "$",
              "name": "meta.field.sha256.trion",
              "patterns": [
                {
                  "include": "#strings"
                },
                {
                  "include": "#comment"
                }
              ]
            },
            {
              "begin": "^\\s*(retrieved)(?=\\s)",
              "beginCaptures": {
                "1": {
                  "name": "keyword.other.field.retrieved.trion"
                }
              },
              "end": "$",
              "name": "meta.field.retrieved.trion",
              "patterns": [
                {
                  "include": "#strings"
                },
                {
                  "include": "#comment"
                }
              ]
            }
          ]
        },
        {
          "match": "^\\s*(kind)\\s+(\\S+?)(?=\\s*(?://.*)?$)",
          "captures": {
            "1": {
              "name": "keyword.other.field.kind.trion"
            },
            "2": {
              "name": "constant.language.kind.trion"
            }
          }
        },
        {
          "match": "^\\s*(transcript)\\s+(\\S+?)(?=\\s*(?://.*)?$)",
          "captures": {
            "1": {
              "name": "keyword.other.field.transcript.trion"
            },
            "2": {
              "name": "constant.language.transcript.trion"
            }
          }
        },
        {
          "match": "^\\s*(minimum)\\s+(\\S+?)(?=\\s*(?://.*)?$)",
          "captures": {
            "1": {
              "name": "keyword.other.field.minimum.trion"
            },
            "2": {
              "name": "constant.numeric.trion"
            }
          }
        },
        {
          "include": "#strings"
        }
      ]
    },
    "check-block": {
      "name": "meta.block.check.trion",
      "begin": "^([ \\t]*)(check)\\s+([A-Z][A-Z0-9-]*)\\s*(:)(?=\\s*(?://.*)?$)",
      "beginCaptures": {
        "2": {
          "name": "storage.type.check.trion"
        },
        "3": {
          "name": "entity.name.check.trion"
        },
        "4": {
          "name": "punctuation.section.block.begin.trion"
        }
      },
      "end": "(?!\\G)^(?!\\1[ \\t]+\\S|[ \\t]*$)",
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "match": "^\\s*(relation)\\s+(\\S+?)(?=\\s*(?://.*)?$)",
          "captures": {
            "1": {
              "name": "keyword.other.field.relation.trion"
            },
            "2": {
              "name": "constant.language.relation.trion"
            }
          }
        },
        {
          "patterns": [
            {
              "begin": "^\\s*(left)(?=\\s)",
              "beginCaptures": {
                "1": {
                  "name": "keyword.other.field.left.trion"
                }
              },
              "end": "$",
              "name": "meta.field.left.trion",
              "patterns": [
                {
                  "include": "#element-reference"
                },
                {
                  "include": "#spec-id-reference"
                },
                {
                  "include": "#comma"
                },
                {
                  "include": "#comment"
                }
              ]
            },
            {
              "begin": "^\\s*(right)(?=\\s)",
              "beginCaptures": {
                "1": {
                  "name": "keyword.other.field.right.trion"
                }
              },
              "end": "$",
              "name": "meta.field.right.trion",
              "patterns": [
                {
                  "include": "#element-reference"
                },
                {
                  "include": "#spec-id-reference"
                },
                {
                  "include": "#comma"
                },
                {
                  "include": "#comment"
                }
              ]
            }
          ]
        },
        {
          "include": "#using-field"
        }
      ]
    },
    "using-field": {
      "match": "^\\s*(using)\\s+(\\S+?)(?=\\s*(?://.*)?$)",
      "captures": {
        "1": {
          "name": "keyword.other.field.using.trion"
        },
        "2": {
          "name": "constant.language.using.trion"
        }
      }
    },
    "example-block": {
      "name": "meta.block.example.trion",
      "begin": "^([ \\t]*)(example)\\s+([A-Z][A-Z0-9-]*)\\s*(:)(?=\\s*(?://.*)?$)",
      "beginCaptures": {
        "2": {
          "name": "storage.type.example.trion"
        },
        "3": {
          "name": "entity.name.example.trion"
        },
        "4": {
          "name": "punctuation.section.block.begin.trion"
        }
      },
      "end": "(?!\\G)^(?!\\1[ \\t]+\\S|[ \\t]*$)",
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "match": "^\\s*(kind)\\s+(\\S+?)(?=\\s*(?://.*)?$)",
          "captures": {
            "1": {
              "name": "keyword.other.field.kind.trion"
            },
            "2": {
              "name": "constant.language.kind.trion"
            }
          }
        },
        {
          "match": "^\\s*(form)\\s+(\\S+?)(?=\\s*(?://.*)?$)",
          "captures": {
            "1": {
              "name": "keyword.other.field.form.trion"
            },
            "2": {
              "name": "constant.language.form.trion"
            }
          }
        },
        {
          "begin": "^\\s*(input)(?=\\s)",
          "beginCaptures": {
            "1": {
              "name": "keyword.other.field.input.trion"
            }
          },
          "end": "$",
          "name": "meta.field.input.trion",
          "patterns": [
            {
              "include": "#strings"
            },
            {
              "include": "#comment"
            }
          ]
        },
        {
          "patterns": [
            {
              "begin": "^\\s*(base)(?=\\s)",
              "beginCaptures": {
                "1": {
                  "name": "keyword.other.field.base.trion"
                }
              },
              "end": "$",
              "name": "meta.field.base.trion",
              "patterns": [
                {
                  "include": "#element-reference"
                },
                {
                  "include": "#spec-id-reference"
                },
                {
                  "include": "#comment"
                }
              ]
            },
            {
              "begin": "^\\s*(candidate)(?=\\s)",
              "beginCaptures": {
                "1": {
                  "name": "keyword.other.field.candidate.trion"
                }
              },
              "end": "$",
              "name": "meta.field.candidate.trion",
              "patterns": [
                {
                  "include": "#element-reference"
                },
                {
                  "include": "#spec-id-reference"
                },
                {
                  "include": "#comment"
                }
              ]
            }
          ]
        },
        {
          "include": "#using-field"
        },
        {
          "begin": "^\\s*(expect)(?=\\s)",
          "beginCaptures": {
            "1": {
              "name": "keyword.other.field.expect.trion"
            }
          },
          "end": "$",
          "name": "meta.field.expect.trion",
          "patterns": [
            {
              "include": "#strings"
            },
            {
              "include": "#element-reference"
            },
            {
              "include": "#spec-id-reference"
            },
            {
              "match": "(?<![\\w$.-])[a-z][a-z-]*(?![\\w-])",
              "name": "constant.language.expectation.trion"
            },
            {
              "include": "#comment"
            }
          ]
        },
        {
          "include": "#strings"
        }
      ]
    },
    "trace-block": {
      "name": "meta.block.trace.trion",
      "begin": "^([ \\t]*)(trace)\\s+([A-Z][A-Z0-9-]*)\\s*(:)(?=\\s*(?://.*)?$)",
      "beginCaptures": {
        "2": {
          "name": "storage.type.trace.trion"
        },
        "3": {
          "name": "entity.name.trace.trion"
        },
        "4": {
          "name": "punctuation.section.block.begin.trion"
        }
      },
      "end": "(?!\\G)^(?!\\1[ \\t]+\\S|[ \\t]*$)",
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "begin": "^\\s*(artifact)(?=\\s)",
          "beginCaptures": {
            "1": {
              "name": "keyword.other.field.artifact.trion"
            }
          },
          "end": "$",
          "name": "meta.field.artifact.trion",
          "patterns": [
            {
              "include": "#strings"
            },
            {
              "include": "#comment"
            }
          ]
        },
        {
          "begin": "^\\s*(verifies)(?=\\s)",
          "beginCaptures": {
            "1": {
              "name": "keyword.other.field.verifies.trion"
            }
          },
          "end": "$",
          "name": "meta.field.verifies.trion",
          "patterns": [
            {
              "include": "#element-reference"
            },
            {
              "include": "#spec-id-reference"
            },
            {
              "include": "#comma"
            },
            {
              "include": "#comment"
            }
          ]
        }
      ]
    },
    "role-block": {
      "name": "meta.block.role.trion",
      "begin": "^([ \\t]*)(role)\\s+([^:]+?)\\s*(:)(?=\\s*(?://.*)?$)",
      "beginCaptures": {
        "2": {
          "name": "storage.type.role.trion"
        },
        "3": {
          "name": "entity.name.type.role.trion"
        },
        "4": {
          "name": "punctuation.section.block.begin.trion"
        }
      },
      "end": "(?!\\G)^(?!\\1[ \\t]+\\S|[ \\t]*$)",
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "match": "^\\s*(activate)\\s*(:)",
          "captures": {
            "1": {
              "name": "keyword.other.directive.activate.trion"
            },
            "2": {
              "name": "punctuation.separator.key-value.trion"
            }
          }
        },
        {
          "match": "^\\s*(form)\\s+([^:\\s]+)\\s*(:)",
          "captures": {
            "1": {
              "name": "keyword.other.directive.form.trion"
            },
            "2": {
              "name": "entity.name.function.form.trion"
            },
            "3": {
              "name": "punctuation.separator.key-value.trion"
            }
          }
        },
        {
          "match": "^\\s*(required)\\s+([^:\\s]+)\\s*(:)",
          "captures": {
            "1": {
              "name": "keyword.other.directive.required.trion"
            },
            "2": {
              "name": "entity.name.function.form.trion"
            },
            "3": {
              "name": "punctuation.separator.key-value.trion"
            }
          }
        },
        {
          "include": "#regex-clause"
        },
        {
          "include": "#role-constraint"
        },
        {
          "include": "#placeholder"
        },
        {
          "include": "#sentence"
        }
      ]
    },
    "role-constraint": {
      "match": "(?<![\\w$.-])(where|when)(?=\\s+\\$)",
      "captures": {
        "1": {
          "name": "keyword.control.constraint.trion"
        }
      }
    },
    "placeholder": {
      "match": "(\\$)[A-Za-z_][\\w-]*",
      "name": "variable.other.placeholder.trion",
      "captures": {
        "1": {
          "name": "punctuation.definition.variable.trion"
        }
      }
    },
    "regex-clause": {
      "begin": "(?<![\\w$.-])(matches|does\\s+not\\s+match)(?![\\w-])\\s+(/)",
      "beginCaptures": {
        "1": {
          "name": "keyword.operator.match.trion"
        },
        "2": {
          "name": "string.regexp.delimiter.trion"
        }
      },
      "end": "(/)(?=\\s+when\\s+\\$|\\s+where\\s+\\$|\\s*[.,]?\\s*$)|$",
      "endCaptures": {
        "1": {
          "name": "string.regexp.delimiter.trion"
        }
      },
      "contentName": "string.regexp.trion",
      "patterns": [
        {
          "match": "\\\\.",
          "name": "constant.character.escape.regexp.trion"
        },
        {
          "match": "\\[(?:\\\\.|[^\\]\\\\])*\\]",
          "name": "constant.other.character-class.regexp.trion"
        },
        {
          "match": "[\\^$]",
          "name": "keyword.control.anchor.regexp.trion"
        },
        {
          "match": "[*+?]|\\{\\d+(?:,\\d*)?\\}",
          "name": "keyword.operator.quantifier.regexp.trion"
        },
        {
          "match": "[()|]",
          "name": "punctuation.definition.group.regexp.trion"
        }
      ]
    },
    "concept-block": {
      "name": "meta.block.concept.trion",
      "begin": "^([ \\t]*)(?:(\\[)([A-Z][A-Z0-9-]*(?:/[a-z][a-z0-9-]*)?)(\\])\\s*)?(concept)\\s*(:)(?=\\s*(?://.*)?$)",
      "beginCaptures": {
        "2": {
          "name": "punctuation.definition.spec-id.begin.trion"
        },
        "3": {
          "name": "entity.name.function.spec-id.trion"
        },
        "4": {
          "name": "punctuation.definition.spec-id.end.trion"
        },
        "5": {
          "name": "storage.type.concept.trion"
        },
        "6": {
          "name": "punctuation.section.block.begin.trion"
        }
      },
      "end": "(?!\\G)^(?!\\1[ \\t]+\\S|[ \\t]*$)",
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#spec-id-declaration"
        },
        {
          "include": "#arrow"
        },
        {
          "include": "#sentence"
        }
      ]
    },
    "diagram-header": {
      "match": "^\\s*(?:(\\[)([A-Z][A-Z0-9-]*(?:/[a-z][a-z0-9-]*)?)(\\])\\s*)?(diagram)\\s+(\\S+?)\\s*(:)(?=\\s*(?://.*)?$)",

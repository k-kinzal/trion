{
  "comments": {
    "lineComment": "//"
  },
  "brackets": [
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "\"",
      "close": "\"",
      "notIn": [
        "string",
        "comment"
      ]
    },
    {
      "open": "`",
      "close": "`",
      "notIn": [
        "string",
        "comment"
      ]
    }
  ],
  "surroundingPairs": [
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ],
    [
      "\"",
      "\""
    ],
    [
      "`",
      "`"
    ]
  ],
  "wordPattern": "\\$?[A-Za-z_][A-Za-z0-9_-]*(?:/[a-z][a-z0-9-]*)?",
  "folding": {
    "offSide": true
  },
  "onEnterRules": [
    {
      "beforeText": "^(?!\\s*//).*:\\s*(//.*)?$",
      "action": {
        "indent": "indent"
      }
    }
  ]
}

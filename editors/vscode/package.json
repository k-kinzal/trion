{
  "name": "trion",
  "displayName": "Trion",
  "description": "Language support for the trion specification language.",
  "version": "0.2.0",
  "publisher": "trion-lang",
  "private": true,
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "The language server path from workspace settings is ignored until the workspace is trusted.",
      "restrictedConfigurations": [
        "trion.server.path"
      ]
    },
    "virtualWorkspaces": {
      "supported": "limited",
      "description": "Syntax highlighting works everywhere. The language server needs files on disk."
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "trion",
        "aliases": [
          "Trion",
          "trion"
        ],
        "extensions": [
          ".trion"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "trion",
        "scopeName": "source.trion",
        "path": "./syntaxes/trion.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "trion.restartServer",
        "title": "Restart Language Server",
        "category": "Trion"
      },
      {
        "command": "trion.openPreview",
        "title": "Open Preview to the Side",
        "category": "Trion",
        "icon": "$(open-preview)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "trion.openPreview",
          "when": "editorLangId == trion",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "trion.openPreview",
          "when": "editorLangId == trion"
        }
      ]
    },
    "configuration": {
      "title": "Trion",
      "properties": {
        "trion.server.path": {
          "type": "string",
          "default": "trion",
          "scope": "machine-overridable",
          "markdownDescription": "Path to the `trion` binary, or a command name to look up on `PATH`. The extension runs the `trion-lsp` binary beside it as the language server."
        },
        "trion.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "scope": "window",
          "description": "Traces the communication between VS Code and the trion language server."
        }
      }
    },
    "configurationDefaults": {
      "[trion]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.semanticHighlighting.enabled": true
      }
    }
  },
  "scripts": {
    "copy-grammar": "node scripts/copy-grammar.mjs",
    "typecheck": "tsc --noEmit",
    "bundle": "esbuild src/extension.ts --bundle --outfile=out/extension.js --platform=node --format=cjs --target=node20 --external:vscode --sourcemap",
    "compile": "npm run copy-grammar && npm run typecheck && npm run bundle",
    "test": "esbuild src/serverPath.ts --outfile=out/serverPath.cjs --platform=node --format=cjs && node --test test/serverPath.test.cjs test/extension.test.cjs",
    "package": "vsce package --skip-license --allow-missing-repository --out trion.vsix",
    "vscode:prepublish": "npm run compile"
  },
  "dependencies": {
    "vscode-languageclient": "9.0.1"
  },
  "devDependencies": {
    "@types/node": "20.19.25",
    "@types/vscode": "1.91.0",
    "@vscode/vsce": "3.7.1",
    "esbuild": "0.25.12",
    "typescript": "5.9.3"
  }
}

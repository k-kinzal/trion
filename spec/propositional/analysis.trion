include "core.trion"
include "queries.trion"
include "grammar.trion"
include "translation.trion"
include "results.trion"
include "extensions.trion"

namespace trion.propositional:
    primitive artifact definition environment, artifact grammar version, artifact semantic version, check trusted base, conclusion
    primitive conversion failure condition, conversion preservation property, external process, network, parser
    primitive result evidence, result scope, solver, unknown constructor

    source FOUNDATION:
        title "Formalization foundation work instruction, edition 1"
        locator "urn:trion:foundation-work-instruction:2026-11-18:1"
        kind citation

    primitive propositional core, propositional parser, propositional printer, propositional translator, propositional checker, propositional runner, propositional worker, propositional maintainer
    system propositional core, propositional parser, propositional printer, propositional translator, propositional checker, propositional runner, propositional worker, propositional maintainer
    environment propositional author

    section "Propositional analysis":
        cite FOUNDATION
        Propositional analysis means the analysis of classical two-valued propositional formulas.

        [F01]
        The propositional core shall record the semantic version of each artifact.

        [F02]
        The propositional core shall reject each unknown constructor.

        [F03]
        The propositional core shall not depend on a parser.
        The propositional core shall not depend on a solver.
        The propositional core shall not use a network.
        The propositional core shall not run an external process.

        [F04]
        The propositional runner shall preserve the original premises.
        The propositional runner shall preserve the original query.

        [F05]
        The propositional translator shall state the preservation property of each conversion.
        The propositional translator shall state the failure conditions of each conversion.

        [F06]
        The propositional runner shall record the conclusion and the evidence of each result.

        [F07]
        The propositional parser shall record the grammar version of each artifact.
        The propositional core shall record the definition environment of each artifact.

        [F08]
        The propositional runner shall record the scope of each result.
        The propositional maintainer shall state the trusted base of each check.
